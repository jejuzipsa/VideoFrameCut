<Window x:Class="VideoFrameCut.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Icon="Assets/FrameCut.png"
        Title="FrameCut — 영상 분할·병합" Height="955" Width="1435"
        MinHeight="755" MinWidth="1110"
        WindowStartupLocation="CenterScreen"
        Background="#151922" Foreground="#E9EDF4"
        FontFamily="Segoe UI" FontSize="14"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="TransportButtonStyle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Background" Value="#29394B"/>
        </Style>
        <!-- The checked border represents the actual rotation, not stale focus. -->
        <Style x:Key="RotationButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="#34465B"/>
            <Setter Property="Foreground" Value="#F0F4FA"/>
            <Setter Property="BorderBrush" Value="#4B6077"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="RotationButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Content" RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RotationButtonSurface" Property="Background" Value="#3C4E63"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RotationButtonSurface" Property="Background" Value="#245D76"/>
                                <Setter TargetName="RotationButtonSurface" Property="BorderBrush" Value="#8BD4E4"/>
                                <Setter TargetName="RotationButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RotationButtonSurface" Property="Background" Value="#252D3A"/>
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="290"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="315"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="AddVideoButton" Content="영상 추가" Click="Open_Click"/>
                <Button Content="원본 전체 보기" Click="FullSource_Click"/>
                <Button Content="선택 구간 재생" Click="PlaySelected_Click"/>
                <Button Content="정확한 프레임 보기" Click="ExactFrame_Click"/>
                <Button x:Name="FFmpegInstallButton" Content="FFmpeg 확인 / 설치"
                        ToolTip="최초 실행 시 자동 설치. 필요하면 다시 검사하거나 재시도합니다."
                        Click="FFmpegInstall_Click"/>
                <Button x:Name="OpenLogFolderButton" Content="오류 로그"
                        ToolTip="인코딩 실패, 코덱 미지원, FFmpeg 오류 로그 폴더 열기"
                        Click="OpenLogFolder_Click"/>
            </StackPanel>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="8,0,0,0" Foreground="#AFC1D5" Text="원본 영상 없음"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.45*"/>
            </Grid.ColumnDefinitions>
            <GroupBox x:Name="SourceGroupBox" Grid.Column="0" Header="① 원본 영상 목록" Margin="0,0,12,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Border x:Name="SourceDropZone" AllowDrop="True"
                                Background="#263849" BorderBrush="#67AFC5"
                                BorderThickness="1" CornerRadius="5" Padding="10"
                                MinHeight="62" Margin="0,0,0,6"
                                PreviewDragOver="Window_PreviewDragOver"
                                PreviewDrop="Window_PreviewDrop">
                            <TextBlock Text="탐색기 MP4 파일 → 여기에 드롭"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="#D5E6F2" FontSize="12"/>
                        </Border>
                        <TextBlock Text="전체 파일 경로 직접 입력 (한 줄에 하나씩)"
                                   Foreground="#AFC1D5" FontSize="11" Margin="0,2,0,4"/>
                        <TextBox x:Name="SourcePathBox" Height="58" MinHeight="45"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 KeyDown="SourcePathBox_KeyDown"
                                 ToolTip="예: D:\\videos\\김선미 (1).mp4&#10;여러 경로는 한 줄에 하나씩 입력"/>
                        <Button x:Name="ImportTypedPathsButton" Content="입력한 경로 불러오기"
                                ToolTip="파일 선택창 없이 입력된 전체 경로를 열기 (Ctrl+Enter)"
                                Click="ImportTypedPaths_Click" Margin="0,4,0,6"/>
                        <Button x:Name="PasteVideoPathsButton" Content="복사한 파일 / 경로 바로 불러오기"
                                ToolTip="탐색기에서 파일 복사(Ctrl+C), 또는 경로 복사 후 클릭"
                                Click="PasteVideoPaths_Click" Margin="0,0,0,6"/>
                        <Button Content="선택 원본 목록에서 제거" Click="RemoveSource_Click" Margin="0"/>
                    </StackPanel>
                    <ListBox x:Name="SourceList" SelectionMode="Single" AllowDrop="True"
                             PreviewDragOver="Window_PreviewDragOver"
                             PreviewDrop="Window_PreviewDrop"
                             SelectionChanged="SourceList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,7" ToolTip="{Binding Path}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Details}" Foreground="#AFC1D5"
                                               TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="100"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="6" Background="#080B10" ClipToBounds="True">
                    <Grid>
                        <!-- LibVLCSharp WPF uses a native video HWND; overlays MUST
                             be placed within VideoView.Content to appear above it. -->
                        <vlc:VideoView x:Name="VideoPreview">
                            <Grid Background="#01000000">
                                <Image x:Name="ExactStill" Stretch="Uniform"
                                       Visibility="Collapsed" IsHitTestVisible="False"/>
                                <Border x:Name="PlaybackNotice" Background="#D0101722"
                                        Visibility="Collapsed" Padding="20"
                                        IsHitTestVisible="False">
                                    <TextBlock x:Name="PlaybackNoticeText"
                                               Text="내장 VLC 재생 엔진 준비 중..."
                                               Foreground="#EAF5FC" FontSize="16"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Preview-only volume, inside VideoView.Content to stay
                                     visible above LibVLC's native HWND. -->
                                <Border x:Name="PreviewVolumePanel" HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom" Margin="0,0,12,12"
                                        Padding="7,4" CornerRadius="6" Background="#D8202938"
                                        BorderBrush="#59758D" BorderThickness="1"
                                        Panel.ZIndex="5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PreviewMuteButton" Content="🔊"
                                                FontFamily="Segoe UI Emoji" FontSize="17"
                                                Width="34" Height="29" MinWidth="34" Padding="0"
                                                Margin="0,0,4,0" ToolTip="미리보기 음소거 / 해제"
                                                Click="PreviewMute_Click"/>
                                        <Slider x:Name="PreviewVolumeSlider" Width="102"
                                                Minimum="0" Maximum="100" Value="50"
                                                VerticalAlignment="Center"
                                                IsMoveToPointEnabled="True"
                                                TickFrequency="1"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                ValueChanged="PreviewVolumeSlider_ValueChanged"
                                                ToolTip="영상 미리보기 음량만 조절 (출력에 영향 없음)"/>
                                        <TextBlock x:Name="PreviewVolumeText" Text="50%"
                                                   Width="37" Margin="7,0,0,0"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="#E8F4FD" FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </vlc:VideoView>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="#202A38" CornerRadius="6" Margin="0,8,0,0" Padding="5,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PreviousClipButton" Content="⏮" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="이전 분할 구간 재생" Click="PreviousClip_Click"/>
                        <Button x:Name="BackSecondsButton" Content="« 3초" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="3초 뒤로 (←)" Click="BackSeconds_Click"/>
                        <Button x:Name="BackFrameButton" Content="‹ 1F" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="1프레임 뒤로 (Ctrl+← 또는 Shift+←)" Click="PreviousFrame_Click"/>
                        <Button x:Name="TransportPlayPauseButton" Content="▶" ToolTip="재생 (Space)"
                                Style="{StaticResource TransportButtonStyle}" MinWidth="60"
                                Background="#23758D" Click="PlayPause_Click"/>
                        <Button x:Name="ForwardFrameButton" Content="1F ›" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="1프레임 앞으로 (Ctrl+→ 또는 Shift+→)" Click="NextFrame_Click"/>
                        <Button x:Name="ForwardSecondsButton" Content="3초 »" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="3초 앞으로 (→)" Click="ForwardSeconds_Click"/>
                        <Button x:Name="NextClipButton" Content="⏭" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="다음 분할 구간 재생" Click="NextClip_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <GroupBox x:Name="EditingGroupBox" Header="편집">
                    <StackPanel>
                        <TextBlock Text="자동 분할 간격(초) · 분할 체크한 구간만" Margin="0,0,0,6"
                                   TextWrapping="Wrap"
                                   ToolTip="아래 구간 목록의 '분할' 열을 체크하세요. 체크가 없으면 선택한 행만 나눕니다."/>
                        <DockPanel>
                            <Button Content="시간으로 나누기" DockPanel.Dock="Right" Click="AutoSplit_Click"
                                    Margin="8,0,0,0"/>
                            <TextBox x:Name="SplitSecondsBox" Text="25" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="PreviewModeText" Text="재생 범위: 원본 전체"
                                   TextWrapping="Wrap" Foreground="#8BD4E4" FontWeight="SemiBold"
                                   Margin="0,6,0,8"/>
                        <WrapPanel Margin="0,0,0,9">
                            <Button Content="시작 프레임 확인" Click="ClipStart_Click"/>
                            <Button Content="끝 프레임 확인" Click="ClipEnd_Click"/>
                        </WrapPanel>
                        <TextBlock Text="수동 컷은 현재 재생 헤드 위치에 적용" Margin="0,12,0,8"
                                   TextWrapping="Wrap" Foreground="#AFC1D5"/>
                        <WrapPanel>
                            <Button Content="S : 나누기" Click="Split_Click"/>
                            <Button x:Name="MergeButton" Content="분할 취소 · 구간 합치기"
                                    ToolTip="Ctrl/Shift로 연속된 구간 2개 이상 선택 후 합치기 (Ctrl+M)"
                                    Click="Merge_Click" IsEnabled="False"/>
                            <Button Content="선택 삭제" Click="Delete_Click"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="실행 취소" Click="Undo_Click"/>
                            <Button Content="다시 실행" Click="Redo_Click"/>
                        </WrapPanel>
                        <Button x:Name="AddToMergeButton" Content="선택 구간 → 병합 목록에 추가"
                                Margin="0,8,0,0" Click="AddToMerge_Click"
                                ToolTip="서로 다른 원본 영상의 구간도 순서대로 추가할 수 있습니다."/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="OutputGroupBox" Header="출력 설정">
                    <StackPanel>
                        <CheckBox x:Name="AudioCheck" Content="원본 오디오 유지" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox x:Name="CpuCheck" Content="CPU 인코더 사용 (libx264)" Margin="0,0,0,8"/>
                        <TextBlock Text="기본: NVENC 자동 시도 → 실패 시 CPU" TextWrapping="Wrap"
                                   Foreground="#AFC1D5" Margin="0,0,0,8"/>
                        <TextBlock Text="프레임 레이트는 원본 그대로 유지합니다."
                                   TextWrapping="Wrap" Foreground="#AFC1D5"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="TransformGroupBox" Header="압축 · 회전 · 좌우 반전">
                  <StackPanel>
                    <TextBlock Text="압축 방식 (3가지 중 선택)" Foreground="#B7C6D8" Margin="0,0,0,7"/>
                    <Grid Margin="0,0,0,7">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <RadioButton x:Name="PresetQualityRadio" GroupName="CompressPreset" IsChecked="True"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="① 고화질 유지 · 용량 절약" TextWrapping="Wrap"/>
                      </RadioButton>
                      <Border x:Name="PresetQualityHelp" Grid.Column="1" Width="22" Height="22"
                              Margin="7,0,0,0" VerticalAlignment="Center"
                              Background="#30485D" BorderBrush="#7494AD" BorderThickness="1"
                              CornerRadius="11" Cursor="Help"
                              ToolTipService.InitialShowDelay="250"
                              ToolTipService.ShowDuration="45000">
                        <Border.ToolTip>
                          <ToolTip MaxWidth="330" Background="#202C3B"
                                   BorderBrush="#718EA5" BorderThickness="1" Padding="12">
                            <StackPanel>
                              <TextBlock Text="① 고화질 유지 · 용량 절약" FontWeight="Bold"
                                         Foreground="#F0F4FA" Margin="0,0,0,7"/>
                              <TextBlock Text="원본 해상도, FPS, HLG/HDR 정보를 유지합니다.&#10;H.265(HEVC) 고화질 압축을 사용합니다.&#10;원본이 AAC 음성이면 복사하고, 아니면 AAC 160kbps로 변환합니다.&#10;&#10;화질 차이를 최소화하지만 완전 무손실은 아닙니다. 이미 압축된 원본은 용량이 줄지 않거나 오히려 커질 수 있습니다." Foreground="#D6E3F0"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                          </ToolTip>
                        </Border.ToolTip>
                        <TextBlock Text="?" FontWeight="Bold" FontSize="13"
                                   Foreground="#E3F2FD" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Border>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <RadioButton x:Name="PresetBalancedRadio" GroupName="CompressPreset"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="② 화질 낮춤 · 용량 절약" TextWrapping="Wrap"/>
                      </RadioButton>
                      <Border x:Name="PresetBalancedHelp" Grid.Column="1" Width="22" Height="22"
                              Margin="7,0,0,0" VerticalAlignment="Center"
                              Background="#30485D" BorderBrush="#7494AD" BorderThickness="1"
                              CornerRadius="11" Cursor="Help"
                              ToolTipService.InitialShowDelay="250"
                              ToolTipService.ShowDuration="45000">
                        <Border.ToolTip>
                          <ToolTip MaxWidth="330" Background="#202C3B"
                                   BorderBrush="#718EA5" BorderThickness="1" Padding="12">
                            <StackPanel>
                              <TextBlock Text="② 균형 압축 · 용량 절약" FontWeight="Bold"
                                         Foreground="#F0F4FA" Margin="0,0,0,7"/>
                              <TextBlock Text="최대 1920×1080(세로 영상은 1080×1920)으로 낮춥니다.&#10;원본 FPS는 유지합니다.&#10;AAC 음성은 그대로 복사하며, AAC가 아니면 160kbps로 변환합니다.&#10;&#10;4K 영상을 작게 만들 때 권장합니다. 원본이 1080p 이하라면 해상도를 키우지 않습니다. HDR 정보는 보존합니다." Foreground="#D6E3F0"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                          </ToolTip>
                        </Border.ToolTip>
                        <TextBlock Text="?" FontWeight="Bold" FontSize="13"
                                   Foreground="#E3F2FD" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Border>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <RadioButton x:Name="PresetSmallRadio" GroupName="CompressPreset"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="③ 영상+음성 압축 · 용량 우선" TextWrapping="Wrap"/>
                      </RadioButton>
                      <Border x:Name="PresetSmallHelp" Grid.Column="1" Width="22" Height="22"
                              Margin="7,0,0,0" VerticalAlignment="Center"
                              Background="#30485D" BorderBrush="#7494AD" BorderThickness="1"
                              CornerRadius="11" Cursor="Help"
                              ToolTipService.InitialShowDelay="250"
                              ToolTipService.ShowDuration="45000">
                        <Border.ToolTip>
                          <ToolTip MaxWidth="330" Background="#202C3B"
                                   BorderBrush="#718EA5" BorderThickness="1" Padding="12">
                            <StackPanel>
                              <TextBlock Text="③ 용량 우선 · 영상 및 음성 압축" FontWeight="Bold"
                                         Foreground="#F0F4FA" Margin="0,0,0,7"/>
                              <TextBlock Text="최대 1280×720(세로 영상은 720×1280)으로 낮춥니다.&#10;60fps 등 높은 FPS는 최대 30fps로 낮춥니다.&#10;음성은 AAC 96kbps로 다시 압축합니다.&#10;&#10;가장 작은 파일을 목표로 하지만 화면 디테일, 빠른 움직임과 음질이 저하될 수 있습니다. HDR 정보는 보존합니다." Foreground="#D6E3F0"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                          </ToolTip>
                        </Border.ToolTip>
                        <TextBlock Text="?" FontWeight="Bold" FontSize="13"
                                   Foreground="#E3F2FD" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Border>
                    </Grid>
                    <TextBlock Text="화면 회전" Foreground="#B7C6D8" Margin="0,0,0,5"/>
                    <WrapPanel Margin="0,0,0,7">
                      <ToggleButton x:Name="RotateLeftButton" Content="↶ 90°"
                                    Style="{StaticResource RotationButtonStyle}"
                                    Click="RotateLeft_Click"
                                    ToolTip="왼쪽 90° 회전 · 다시 누르면 회전 해제"/>
                      <ToggleButton x:Name="RotateRightButton" Content="↷ 90°"
                                    Style="{StaticResource RotationButtonStyle}"
                                    Click="RotateRight_Click"
                                    ToolTip="오른쪽 90° 회전 · 다시 누르면 회전 해제"/>
                      <ToggleButton x:Name="Rotate180Button" Content="180°"
                                    Style="{StaticResource RotationButtonStyle}"
                                    Click="Rotate180_Click"
                                    ToolTip="180° 회전 · 다시 누르면 0°로 돌아갑니다"/>
                    </WrapPanel>
                    <CheckBox x:Name="FlipHorizontalCheck" Content="좌우 반전" Margin="0,0,0,7"
                              Checked="FlipHorizontal_Changed" Unchecked="FlipHorizontal_Changed"/>
                    <TextBlock x:Name="OrientationText" Text="회전 0° · 좌우 반전 안 함" Foreground="#8BD4E4"
                               TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <WrapPanel Margin="0,0,0,7">
                      <Button x:Name="TransformPreviewButton" Content="정지화면 미리보기" Click="TransformPreview_Click"
                              ToolTip="현재 프레임의 회전·반전 결과 확인. 재생 화면은 원본으로 표시"/>
                      <Button x:Name="TransformResetButton" Content="초기화" Click="TransformReset_Click"/>
                    </WrapPanel>
                    <Button x:Name="TranscodeExportButton" Content="압축·변환 MP4 저장" Click="TranscodeExport_Click"
                            IsEnabled="False" Background="#246D86" Margin="0"/>
                    <TextBlock Text="원본 파일 보존 · HEVC(H.265) 출력&#10;HDR 영상은 HDR 정보 유지"
                               TextWrapping="Wrap" FontSize="11" Foreground="#B7C6D8" Margin="0,7,0,0"/>
                  </StackPanel>
                </GroupBox>
              </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock x:Name="FrameTimeText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Text="00:00:00.000 / Frame 0" FontWeight="SemiBold"/>
                <TextBlock Text="타임라인 (구간 선택 시 해당 범위로 제한)" Foreground="#AFC1D5"/>
            </DockPanel>
            <Slider x:Name="SeekSlider" Grid.Row="1" Minimum="0" Maximum="1" Value="0"
                    Margin="0,8,0,0" TickFrequency="1" IsSnapToTickEnabled="True"
                    IsMoveToPointEnabled="True" AutoToolTipPlacement="BottomRight"
                    AutoToolTipPrecision="0" ValueChanged="SeekSlider_ValueChanged"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.05*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <GroupBox x:Name="ClipsGroupBox" Grid.Column="0" Header="② 분할 구간 목록 (분할 대상 체크 / Ctrl·Shift 다중 선택)">
            <DataGrid x:Name="ClipGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="False"
                      SelectionChanged="ClipGrid_SelectionChanged"
                      MouseDoubleClick="ClipGrid_MouseDoubleClick"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      AlternationCount="2" ColumnHeaderHeight="38">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="출력" Width="66"
                        ElementStyle="{StaticResource DarkGridCheckBoxStyle}"
                        EditingElementStyle="{StaticResource DarkGridCheckBoxStyle}"
                        Binding="{Binding ExportEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridCheckBoxColumn Header="분할" Width="68"
                        ElementStyle="{StaticResource DarkGridCheckBoxStyle}"
                        EditingElementStyle="{StaticResource DarkGridCheckBoxStyle}"
                        Binding="{Binding SplitTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="#" Width="50" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding Number}"/>
                    <DataGridTextColumn Header="시작 시간" Width="135" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding FromTime}"/>
                    <DataGridTextColumn Header="끝 시간" Width="135" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding ToTime}"/>
                    <DataGridTextColumn Header="원본 프레임 [시작, 끝)" Width="180" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding RangeText}"/>
                    <DataGridTextColumn Header="프레임 수" Width="100" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding FrameCount}"/>
                    <DataGridTextColumn Header="길이" Width="110" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding Duration}"/>
                </DataGrid.Columns>
            </DataGrid>
            </GroupBox>
            <GroupBox x:Name="MergeGroupBox" Grid.Column="1" Header="③ 병합 작업 · 구간 순서 지정" Margin="12,0,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <WrapPanel Margin="0,0,0,4">
                            <Button x:Name="MergeMoveUpButton" Content="↑ 위로" Click="MergeMoveUp_Click"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="MergeMoveDownButton" Content="↓ 아래로" Click="MergeMoveDown_Click"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="MergeRemoveButton" Content="제거" Click="MergeRemove_Click"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="MergeClearButton" Content="비우기" Click="MergeClear_Click"/>
                        </WrapPanel>
                        <DockPanel Margin="0,4,0,5">
                            <TextBlock Text="연결 방식" DockPanel.Dock="Left"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="MergeTransitionCombo" SelectedIndex="0" MinHeight="28"
                                      SelectionChanged="MergeTransition_SelectionChanged">
                                <ComboBoxItem Content="기본 (컷 연결)"/>
                                <ComboBoxItem Content="크로스페이드"/>
                                <ComboBoxItem Content="페이드 아웃·인 (검은 화면)"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="전환 시간(초)" DockPanel.Dock="Left"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TransitionSecondsBox" Text="0.5"
                                     VerticalContentAlignment="Center" IsEnabled="False"
                                     ToolTip="크로스페이드/페이드아웃일 때 0.1~3.0초"/>
                        </DockPanel>
                        <Button x:Name="MergeExportButton" Content="병합 → MP4 한 파일 출력"
                                Background="#246D86" Margin="0"
                                Click="MergeExport_Click" IsEnabled="False"/>
                    </StackPanel>
                    <ListBox x:Name="MergeQueue" SelectionMode="Single"
                             SelectionChanged="MergeQueue_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,5">
                                    <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Details}" FontSize="11"
                                               Foreground="#AFC1D5" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="ExportButton" Content="체크한 구간 MP4 출력" Click="Export_Click"
                    Background="#246D86" MinWidth="175" IsEnabled="False"/>
            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                <TextBlock x:Name="StatusText" Text="영상 파일을 열어 주세요." TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="ExportProgressBar" Height="7" Margin="0,8,0,0"
                             Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="CancelButton" Content="작업 취소"
                    Click="Cancel_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
