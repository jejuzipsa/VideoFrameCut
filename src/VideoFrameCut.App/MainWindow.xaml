<Window x:Class="VideoFrameCut.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Icon="Assets/FrameCut.png"
        Title="FrameCut — 초기 개발 버전" Height="870" Width="1360"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#151922" Foreground="#E9EDF4"
        FontFamily="Segoe UI" FontSize="14"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="TransportButtonStyle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Background" Value="#29394B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="290"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="245"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="AddVideoButton" Content="영상 추가" Click="Open_Click"/>
                <Button Content="원본 전체 보기" Click="FullSource_Click"/>
                <Button Content="선택 구간 재생" Click="PlaySelected_Click"/>
                <Button Content="정확한 프레임 보기" Click="ExactFrame_Click"/>
                <Button x:Name="FFmpegInstallButton" Content="FFmpeg 확인 / 설치"
                        ToolTip="최초 실행 시 자동 설치. 필요하면 다시 검사하거나 재시도합니다."
                        Click="FFmpegInstall_Click"/>
            </StackPanel>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="8,0,0,0" Foreground="#AFC1D5" Text="원본 영상 없음"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.45*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="① 원본 영상 목록" Margin="0,0,12,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="영상 파일을 이 창에 끌어 놓으세요." TextWrapping="Wrap"
                                   Foreground="#AFC1D5" FontSize="12" Margin="0,0,0,7"/>
                        <Button Content="선택 원본 목록에서 제거" Click="RemoveSource_Click" Margin="0"/>
                    </StackPanel>
                    <ListBox x:Name="SourceList" SelectionMode="Single"
                             SelectionChanged="SourceList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,7" ToolTip="{Binding Path}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Details}" Foreground="#AFC1D5"
                                               TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="100"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="6" Background="#080B10" ClipToBounds="True">
                    <Grid>
                        <!-- LibVLCSharp WPF uses a native video HWND; overlays MUST
                             be placed within VideoView.Content to appear above it. -->
                        <vlc:VideoView x:Name="VideoPreview">
                            <Grid Background="#01000000">
                                <Image x:Name="ExactStill" Stretch="Uniform"
                                       Visibility="Collapsed" IsHitTestVisible="False"/>
                                <Border x:Name="PlaybackNotice" Background="#D0101722"
                                        Visibility="Collapsed" Padding="20"
                                        IsHitTestVisible="False">
                                    <TextBlock x:Name="PlaybackNoticeText"
                                               Text="내장 VLC 재생 엔진 준비 중..."
                                               Foreground="#EAF5FC" FontSize="16"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </vlc:VideoView>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="#202A38" CornerRadius="6" Margin="0,8,0,0" Padding="5,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PreviousClipButton" Content="⏮" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="이전 분할 구간 재생" Click="PreviousClip_Click"/>
                        <Button x:Name="BackSecondsButton" Content="« 3초" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="3초 뒤로 (←)" Click="BackSeconds_Click"/>
                        <Button x:Name="BackFrameButton" Content="‹ 1F" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="1프레임 뒤로 (Ctrl+← 또는 Shift+←)" Click="PreviousFrame_Click"/>
                        <Button x:Name="TransportPlayPauseButton" Content="▶" ToolTip="재생 (Space)"
                                Style="{StaticResource TransportButtonStyle}" MinWidth="60"
                                Background="#23758D" Click="PlayPause_Click"/>
                        <Button x:Name="ForwardFrameButton" Content="1F ›" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="1프레임 앞으로 (Ctrl+→ 또는 Shift+→)" Click="NextFrame_Click"/>
                        <Button x:Name="ForwardSecondsButton" Content="3초 »" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="3초 앞으로 (→)" Click="ForwardSeconds_Click"/>
                        <Button x:Name="NextClipButton" Content="⏭" Style="{StaticResource TransportButtonStyle}"
                                ToolTip="다음 분할 구간 재생" Click="NextClip_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Column="2">
                <GroupBox Header="편집">
                    <StackPanel>
                        <TextBlock Text="자동 분할 간격(초)" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button Content="시간으로 나누기" DockPanel.Dock="Right" Click="AutoSplit_Click"
                                    Margin="8,0,0,0"/>
                            <TextBox x:Name="SplitSecondsBox" Text="25" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="PreviewModeText" Text="재생 범위: 원본 전체"
                                   TextWrapping="Wrap" Foreground="#8BD4E4" FontWeight="SemiBold"
                                   Margin="0,6,0,8"/>
                        <WrapPanel Margin="0,0,0,9">
                            <Button Content="시작 프레임 확인" Click="ClipStart_Click"/>
                            <Button Content="끝 프레임 확인" Click="ClipEnd_Click"/>
                        </WrapPanel>
                        <TextBlock Text="수동 컷은 현재 재생 헤드 위치에 적용" Margin="0,12,0,8"
                                   TextWrapping="Wrap" Foreground="#AFC1D5"/>
                        <WrapPanel>
                            <Button Content="S : 나누기" Click="Split_Click"/>
                            <Button x:Name="MergeButton" Content="분할 취소 · 구간 합치기"
                                    ToolTip="Ctrl/Shift로 연속된 구간 2개 이상 선택 후 합치기 (Ctrl+M)"
                                    Click="Merge_Click" IsEnabled="False"/>
                            <Button Content="선택 삭제" Click="Delete_Click"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="실행 취소" Click="Undo_Click"/>
                            <Button Content="다시 실행" Click="Redo_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="출력 설정">
                    <StackPanel>
                        <CheckBox x:Name="AudioCheck" Content="원본 오디오 유지" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox x:Name="CpuCheck" Content="CPU 인코더 사용 (libx264)" Margin="0,0,0,8"/>
                        <TextBlock Text="기본: NVENC 자동 시도 → 실패 시 CPU" TextWrapping="Wrap"
                                   Foreground="#AFC1D5" Margin="0,0,0,8"/>
                        <TextBlock Text="프레임 레이트는 원본 그대로 유지합니다."
                                   TextWrapping="Wrap" Foreground="#AFC1D5"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock x:Name="FrameTimeText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Text="00:00:00.000 / Frame 0" FontWeight="SemiBold"/>
                <TextBlock Text="타임라인 (구간 선택 시 해당 범위로 제한)" Foreground="#AFC1D5"/>
            </DockPanel>
            <Slider x:Name="SeekSlider" Grid.Row="1" Minimum="0" Maximum="1" Value="0"
                    Margin="0,8,0,0" TickFrequency="1" IsSnapToTickEnabled="True"
                    IsMoveToPointEnabled="True" AutoToolTipPlacement="BottomRight"
                    AutoToolTipPrecision="0" ValueChanged="SeekSlider_ValueChanged"/>
        </Grid>

        <GroupBox Grid.Row="3" Header="② 분할 구간 목록 (한 번 클릭: 구간 선택 / 더블클릭: 해당 구간만 재생)">
            <DataGrid x:Name="ClipGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="False"
                      SelectionChanged="ClipGrid_SelectionChanged"
                      MouseDoubleClick="ClipGrid_MouseDoubleClick"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      AlternationCount="2" ColumnHeaderHeight="38">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="출력" Width="66"
                        ElementStyle="{StaticResource DarkGridCheckBoxStyle}"
                        EditingElementStyle="{StaticResource DarkGridCheckBoxStyle}"
                        Binding="{Binding ExportEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="#" Width="50" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding Number}"/>
                    <DataGridTextColumn Header="시작 시간" Width="135" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding FromTime}"/>
                    <DataGridTextColumn Header="끝 시간" Width="135" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding ToTime}"/>
                    <DataGridTextColumn Header="원본 프레임 [시작, 끝)" Width="180" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding RangeText}"/>
                    <DataGridTextColumn Header="프레임 수" Width="100" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding FrameCount}"/>
                    <DataGridTextColumn Header="길이" Width="110" IsReadOnly="True"
                        ElementStyle="{StaticResource DarkDataGridTextStyle}" Binding="{Binding Duration}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="ExportButton" Content="체크한 구간 MP4 출력" Click="Export_Click"
                    Background="#246D86" MinWidth="175" IsEnabled="False"/>
            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                <TextBlock x:Name="StatusText" Text="영상 파일을 열어 주세요." TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="ExportProgressBar" Height="7" Margin="0,8,0,0"
                             Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="CancelButton" Content="작업 취소"
                    Click="Cancel_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
